# Copy to .env.local for local development. The database and object-store
# credentials that used to live here belong to wascat-backend now.

# Where the API is. Every /api/v1/* request is rewritten to it.
WASCAT_API_ORIGIN=http://127.0.0.1:8000

# Where the object store is. Frames are addressed as "/frames/..." on this
# site's own origin and rewritten here, so they are optimised as local images
# and no storage host has to be declared in images.remotePatterns.
WASCAT_ASSET_ORIGIN=http://127.0.0.1:9000/wascat

# Shared with the backend, so a published edit can invalidate the cache.
WASCAT_REVALIDATE_SECRET=dev-only-change-me

# Only for deployments that serve frames straight off a CDN. Set it, and set
# the backend's WASCAT_PUBLIC_ASSET_BASE_URL to the same value, so the API
# emits absolute URLs and next/image is allowed to fetch that host. Leave it
# empty whenever the /frames rewrite above is doing the work.
# NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.example.org/wascat
